# Node.js 24.x is required. Default settings run a local demo only.
PORT=4000
HOST=127.0.0.1
DATABASE_PATH=data/brightpath.sqlite
DEMO_MODE=true
SECURE_COOKIES=false
APP_ORIGINS=http://localhost:4000,http://127.0.0.1:4000,http://localhost:5173,http://127.0.0.1:5173
# For a new non-demo installation, set DEMO_MODE=false, set a new DATABASE_PATH,
# and provide both values below. Use a strong unique password of at least 12 chars.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=replace-with-a-unique-password
# For HTTPS hosting set HOST=0.0.0.0, SECURE_COOKIES=true, and your exact APP_ORIGINS.
